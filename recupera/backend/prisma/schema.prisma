// Schema multi-tenant da Recupera.
// Regra de ouro: nenhuma tabela do núcleo tem coluna fixa de um único setor.
// A sensibilidade de dado e o comportamento do sistema são resolvidos pelo
// campo `segmento` do tenant (ver /docs/especificacao-seguranca-lgpd.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  ATENDENTE
  READ_ONLY
}

model Tenant {
  id        String   @id @default(uuid())
  nome      String
  // Resolve dinamicamente a sensibilidade de dado e o comportamento do
  // agente de IA. Nunca criar tabela separada por setor nem coluna fixa
  // (ex.: "prontuario") — ver Referência Rápida 1 do Guia Mestre.
  segmento  String
  // Retenção de arquivos configurável por tenant (Dia 4 / Prompt 2.1) — mas
  // sempre com piso mínimo decidido pelo `segmento` (config/segmentos.ts),
  // nunca abaixo do que a sensibilidade do segmento exige.
  retencaoArquivosDias Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  clientes          Cliente[]
  refreshTokens     RefreshToken[]
  arquivos          Arquivo[]
  solicitacoesLgpd  SolicitacaoLgpd[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  role         Role     @default(ATENDENTE)
  // Desativação lógica (Dia 3): usuário inativo não consegue mais logar.
  active       Boolean  @default(true)
  // MFA/TOTP — obrigatório para OWNER e ADMIN (ver Prompt 1.3). O segredo
  // nunca é gravado em texto puro: sempre passa por lib/crypto.ts
  // (AES-256-GCM) antes de chegar ao banco.
  mfaSecret    String?
  mfaEnabled   Boolean  @default(false)
  // Última janela TOTP aceita (epoch / 30s). O RFC 6238 exige que o mesmo
  // código nunca seja aceito duas vezes: sem isto, um código interceptado
  // vale por toda a janela de 30s e pode ser replayado.
  mfaUltimaJanela Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  // Login busca por e-mail antes de o tenant ser conhecido (fluxo de auth é
  // a única exceção documentada ao acesso sempre-escopado-por-tenant).
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// Sessões de refresh (Dia 3): tokens opacos, guardados só como hash SHA-256
// (nunca em texto puro — mesma régua de um "secret"), para permitir
// invalidação real no logout. Manipulado exclusivamente via o Prisma Client
// "cru" (prismaUnscoped) pelo módulo de auth: refresh/logout acontecem antes
// de haver um tenant autenticado no contexto da requisição.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tenantId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("refresh_tokens")
}

// Entidade de exemplo, genérica em todos os segmentos, para validar o
// isolamento de tenant (Dia 2). Nenhum campo específico de setor aqui.
model Cliente {
  id        String   @id @default(uuid())
  tenantId  String
  nome      String
  telefone  String
  email     String?
  // Campo cadastral corrigível pelo titular (Dia 5 / Prompt 2.2). Genérico
  // em qualquer segmento — endereço não é campo de setor único.
  endereco  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arquivos         Arquivo[]
  solicitacoesLgpd SolicitacaoLgpd[]

  @@index([tenantId])
  @@map("clientes")
}

// Storage privado (Dia 4 / Prompt 2.1). O arquivo em si nunca fica num path
// público: storagePath é interno (lib/storage) e só é exposto via URL
// assinada de curta duração (lib/signedUrl.ts). `tipo` é uma categoria
// genérica livre (ex.: "documento", "comprovante") — nunca nome de setor
// fixo, mesma regra do núcleo do produto.
model Arquivo {
  id                     String    @id @default(uuid())
  tenantId               String
  // Titular a que o arquivo pertence, quando houver. É o que permite a
  // portabilidade listar "referências de arquivo do titular" e a exclusão
  // LGPD alcançar os arquivos da pessoa (Dia 5 / Prompt 2.2).
  clienteId              String?
  tipo                   String
  nomeOriginal           String
  mimeType               String
  tamanhoBytes           Int
  // Path relativo dentro do storage privado: tenantId/tipo/uuid-hash.ext —
  // nunca o nome original do arquivo (pode revelar informação sensível).
  storagePath            String    @unique
  // Calculado no upload a partir de config/segmentos.ts (retenção padrão do
  // segmento do tenant, ou a configurada em Tenant.retencaoArquivosDias,
  // nunca abaixo do piso mínimo do segmento).
  retentionUntil         DateTime
  // Prazo legal (ex.: fiscal) — enquanto true, nem a exclusão manual nem a
  // varredura automática de retenção apagam o arquivo.
  exclusaoBloqueada      Boolean   @default(false)
  motivoBloqueioExclusao String?
  createdAt              DateTime  @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([clienteId])
  @@map("arquivos")
}

/// Log de auditoria de toda ação sensível (Dia 5 / Prompt 2.2). Generaliza
/// o antigo LogAcessoArquivo do Dia 4.
///
/// Imutabilidade e retenção mínima de 5 anos NÃO dependem do código da
/// aplicação: a migration instala um trigger que recusa qualquer UPDATE e
/// só permite DELETE de linha com mais de 5 anos. Assim a garantia vale
/// também para quem chegar no banco por fora do backend.
///
/// `detalhes` nunca recebe senha/token/secret em texto puro, e CPF/e-mail
/// entram mascarados — ver lib/mascarar.ts e lib/auditoria.ts.
model LogAuditoria {
  id         String   @id @default(uuid())
  /// Nulo apenas em evento anterior à identificação do tenant (ex.: login
  /// que falhou antes de saber a qual tenant a tentativa pertencia).
  ///
  /// Sem foreign key para `tenants` de propósito: o log precisa sobreviver
  /// à exclusão do tenant — é justamente quando a trilha mais importa. Uma
  /// FK obrigaria a apagar (cascade) ou a atualizar (set null) a linha, e
  /// os dois são proibidos numa tabela append-only com retenção de 5 anos.
  tenantId   String?
  userId     String?
  acao       String
  entidade   String
  entidadeId String?
  detalhes   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entidade, entidadeId])
  @@map("logs_auditoria")
}

enum TipoSolicitacaoLgpd {
  EXPORTACAO
  CORRECAO
  EXCLUSAO
}

enum StatusSolicitacaoLgpd {
  PENDENTE
  AGUARDANDO_CONFIRMACAO
  BLOQUEADA
  CONCLUIDA
  REJEITADA
}

/// Solicitações dos direitos do titular (Dia 5 / Prompt 2.2). Existe para
/// que portabilidade, correção e exclusão sejam rastreáveis: quem pediu,
/// quem aprovou, qual o prazo legal e por que uma exclusão ficou bloqueada.
model SolicitacaoLgpd {
  id        String                @id @default(uuid())
  tenantId  String
  clienteId String
  tipo      TipoSolicitacaoLgpd
  status    StatusSolicitacaoLgpd @default(PENDENTE)

  solicitadoPorId String
  aprovadoPorId   String?
  aprovadoEm      DateTime?

  /// Prazo de atendimento do direito do titular (15 dias, Prompt 2.2).
  prazoAtendimento DateTime

  /// CORREÇÃO: campos cadastrais propostos, aplicados só após o titular
  /// confirmar com o token. O token é guardado apenas como hash SHA-256.
  correcaoProposta      Json?
  tokenConfirmacaoHash  String?   @unique
  tokenConfirmacaoAteEm DateTime?

  /// EXCLUSÃO bloqueada por obrigação legal (fiscal/contratual): motivo
  /// registrado e data em que a exclusão passa a ser executada sozinha.
  motivoBloqueio String?
  bloqueadoAteEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clienteId])
  @@index([status, bloqueadoAteEm])
  @@map("solicitacoes_lgpd")
}
