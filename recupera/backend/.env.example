DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recupera_dev?schema=public"
JWT_SECRET="troque-este-segredo-em-producao"
# Chave AES-256 (64 caracteres hex = 32 bytes) usada para criptografar o
# segredo TOTP de MFA em repouso. Gere uma nova por ambiente com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY="1a6f49197e0764045c95cbbf9dae60dcc1081a5b78ca0dd56433e2ce67a4744f"
# Assina as URLs de download de arquivo (expiração curta, Dia 4). Gere uma
# nova por ambiente com o mesmo comando acima.
FILE_URL_SECRET="6a5255d5115607038974dc8ce214664d098fc1bb6325a0319cd02ee2dc621ac5"
# Raiz do storage privado local. Opcional — padrão: ./storage-privado
# STORAGE_ROOT="./storage-privado"
# Quantos proxies confiáveis existem na frente da app (0 = nenhum). Atrás de
# um load balancer, precisa ser ajustado ou o rate limiting por IP vira um
# balde único para todos os clientes. Nunca use um número maior que o real:
# o cliente passaria a forjar o próprio IP via X-Forwarded-For.
TRUST_PROXY=0
PORT=3000
# Origens autorizadas a chamar a API pelo navegador (separadas por vírgula).
# Nunca use "*": a API responde com dado de tenant autenticado.
CORS_ORIGENS="http://localhost:5173"
